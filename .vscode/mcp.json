{
	"servers": {
		"mcpSupabase": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"@supabase/mcp-server-supabase@latest",
				"--project-ref=dcgkzuouqeznxtfzgdil"
			],
			"env": {
				"SUPABASE_ACCESS_TOKEN": "your_supabase_personal_access_token_here"
			}
		},
		"mcpContext7": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"@upstash/context7-mcp"
			]
		},
		"mcpAceternityui": {
			"command": "npx",
			"args": [
				"aceternityui-mcp"
			],
			"type": "stdio"
		},
		"supabase": {
			"type": "http",
			"url": "https://mcp.supabase.com/mcp?project_ref=dcgkzuouqeznxtfzgdil&features=docs,account,database,debugging,development,functions,branching"
		}
	},
	"inputs": []
}